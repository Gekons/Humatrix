[Unit]
Description=Einladungsseite fuer den Matrix-Server
After=network-online.target matrix-synapse.service
Wants=network-online.target

[Service]
Type=simple
User=einladung
Group=einladung
WorkingDirectory=/opt/einladung
ExecStart=/usr/bin/python3 /opt/einladung/einladung.py
Restart=always
RestartSec=10

# Absicherung: der Dienst braucht fast nichts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/einladung
# Dort legt die Verwaltung den Update-Auftrag ab ("Jetzt aktualisieren"), mehr
# nicht. Das '-' laesst den Dienst auch starten, falls der Ordner noch fehlt.
ReadWritePaths=-/var/lib/messenger/auftraege
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
