[Unit]
Description=Einladungsseite fuer den Matrix-Server
After=network-online.target matrix-synapse.service
Wants=network-online.target

[Service]
Type=simple
User=einladung
Group=einladung
WorkingDirectory=/opt/einladung
ExecStart=/usr/bin/python3 /opt/einladung/einladung.py
Restart=always
RestartSec=10

# Absicherung: der Dienst braucht fast nichts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/einladung
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
